---
import { getCollection } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('docs');
  // Quick Start lives at /docs/, where index.astro renders this same entry. Emitting it
  // here too put one page at two indexable URLs, which is what Search Console reported as
  // "Duplicate, Google chose different canonical than user". The old address stays alive
  // as a redirect in astro.config.mjs rather than being deleted.
  return entries
    .filter(entry => entry.slug !== 'getting-started')
    .map(entry => ({
      params: { slug: entry.slug },
      props:  { entry },
    }));
}

const { entry } = Astro.props;
const { Content, headings } = await entry.render();
---

<DocsLayout
  title={entry.data.title}
  headings={headings}
>
  <Content />
</DocsLayout>
